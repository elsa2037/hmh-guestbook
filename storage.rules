rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isHmhSchoolDomain() {
      return isSignedIn() && request.auth.token.email.matches('.*@hmh\\.or\\.kr$');
    }
    
    function isUnder2MB() {
      return request.resource.size <= 2 * 1024 * 1024;
    }

    match /attachments/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isHmhSchoolDomain()
                   && request.auth.uid == userId
                   && isUnder2MB();
      allow delete: if request.auth.uid == userId;
    }
  }
}
