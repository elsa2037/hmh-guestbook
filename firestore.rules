rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function: Check if user email ends with @hmh.or.kr
    function isHmhSchoolDomain() {
      return isSignedIn() && request.auth.token.email.matches('.*@hmh\\.or\\.kr$');
    }
    
    // Helper function: Check if request author matches document author
    function isOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }
    
    // Helper function: Check if user is an admin
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['admin@hmh.or.kr', 'teacher@hmh.or.kr'];
    }

    // Guestbook Collection Rules
    match /guestbook/{docId} {
      allow read: if isSignedIn();
      allow create: if isHmhSchoolDomain() 
                   && request.resource.data.authorId == request.auth.uid
                   && request.resource.data.content.size() <= 140;
      allow update: if isSignedIn() && (
        // Allow users to toggle likes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      );
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Board Posts Collection Rules
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isHmhSchoolDomain()
                   && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isHmhSchoolDomain() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }
  }
}
